---
// Featured sites get a full-width feature row, alternating sides. Everything
// else is listed below as compact links. Then one line for the projects in
// progress (a count, never names) and a link to Contact.
import SiteCard from "../ui/SiteCard.astro";
import { getSites } from "../../lib/sites";
import { work } from "../../config/site";

const sites = await getSites();
const featured = sites.filter((site) => site.featured);
const more = sites.filter((site) => !site.featured);
if (!Number.isInteger(work.inProgress) || work.inProgress < 0) {
  throw new Error(
    `[Work] work.inProgress must be a whole number, 0 or more. Got: ${work.inProgress}`,
  );
}
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <h2 id="work-title">Sites I've built</h2>

    <ul class="work__list">
      {featured.map((site, index) => (
        <li>
          <SiteCard site={site} index={index} />
        </li>
      ))}
    </ul>

    {more.length > 0 && (
      <div class="work__more">
        <h3>More work</h3>
        <ul>
          {more.map((site) => (
            <li>
              <a href={site.url} target="_blank" rel="noopener">
                {site.name}
              </a>
              <span>{site.location}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="work__next">
      {work.inProgress > 0 && (
        <span>{work.inProgressLine(work.inProgress)}</span>
      )}
      <a href={work.nextCta.href}>{work.nextCta.label}</a>
    </p>
  </div>
</section>

<style>
  .work {
    padding-top: var(--space-7);
    background: var(--color-surface);
  }

  h2 {
    margin-bottom: var(--space-7);
    font-size: var(--font-size-xl);
  }

  .work__list {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .work__list {
      gap: var(--space-9);
    }
  }

  .work__more {
    margin-top: var(--space-8);
  }

  .work__more h3 {
    margin-bottom: var(--space-4);
    font-size: var(--font-size-md);
  }

  .work__more ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work__more li {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-line);
  }

  .work__more span {
    color: var(--color-muted);
    font-size: var(--font-size-sm);
  }

  .work__next {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .work__next a {
    color: var(--color-accent);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }
</style>
