---
// A single quiet line between Services and Contact.
import Logo from "../art/Logo.astro";
import { statement } from "../../config/site";
---

<section class="statement" aria-label="About this site">
  <div class="container statement__inner" data-reveal>
    <span class="statement__mark">
      <Logo size={28} />
    </span>
    <p>
      {statement.lead} <span>{statement.follow}</span>
    </p>
  </div>
</section>

<style>
  .statement {
    padding-block: var(--space-8) var(--space-9);
  }

  .statement__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .statement__mark {
    display: inline-flex;
    color: var(--color-accent);
  }

  p {
    max-width: 22ch;
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: var(--font-size-xl);
    font-weight: 750;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  p span {
    display: block;
    color: var(--color-muted);
  }
</style>
