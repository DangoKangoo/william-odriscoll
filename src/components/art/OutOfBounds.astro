---
// 404 illustration: the green in the distance, and the ball resting in the
// rough beside a white out-of-bounds stake. Static, no animation.
import { contourPaths } from "../../lib/topo";

const pin = { x: 440, y: 150 };
const ball = { x: 150, y: 318 };
const stake = { x: 112, y: 262 };
const contours = contourPaths({
  cx: pin.x,
  cy: pin.y,
  rings: 12,
  spacing: 24,
  seed: 18,
});

// Short grass tufts around the ball, as [x, y] offsets.
const tufts = [
  [-34, 10],
  [-18, 16],
  [20, 12],
  [36, 4],
  [-6, 22],
  [48, 18],
];
---

<svg
  class="oob"
  viewBox="0 0 600 400"
  role="img"
  aria-label="A golf ball resting in the rough next to a white out-of-bounds stake, far from the green"
>
  <defs>
    <radialGradient id="oob-green" cx="50%" cy="50%" r="50%">
      <stop
        offset="0%"
        stop-color="var(--color-accent)"
        stop-opacity="0.22"
      ></stop>
      <stop
        offset="100%"
        stop-color="var(--color-accent)"
        stop-opacity="0"
      ></stop>
    </radialGradient>
    <!-- Fades the contours out toward the edges instead of cutting them off. -->
    <radialGradient id="oob-fade-gradient" cx="50%" cy="50%" r="50%">
      <stop offset="60%" stop-color="#fff"></stop>
      <stop offset="100%" stop-color="#000"></stop>
    </radialGradient>
    <mask id="oob-fade">
      <rect width="600" height="400" fill="url(#oob-fade-gradient)"></rect>
    </mask>
  </defs>

  <ellipse
    cx={pin.x}
    cy={pin.y}
    rx="120"
    ry="96"
    fill="url(#oob-green)"
  ></ellipse>
  <g class="oob__lines" mask="url(#oob-fade)">
    {contours.map((d, i) => (
      <path
        d={d}
        class:list={["oob__line", { "oob__line--major": i % 4 === 1 }]}
      />
    ))}
  </g>

  <g transform={`translate(${pin.x} ${pin.y})`}>
    <ellipse class="oob__cup" rx="8" ry="3.5"></ellipse>
    <line class="oob__pole" x1="0" y1="0" x2="0" y2="-74"></line>
    <path class="oob__flag" d="M0 -74 L36 -63 L0 -52 Z"></path>
  </g>

  <g class="oob__tufts">
    {tufts.map(([dx, dy]) => (
      <path d={`M${ball.x + dx - 5} ${ball.y + dy} l3 -9 l2 9 l3 -7 l2 7`} />
    ))}
  </g>

  <g transform={`translate(${stake.x} ${stake.y})`}>
    <ellipse class="oob__shadow" cx="4" cy="62" rx="10" ry="3"></ellipse>
    <path class="oob__stake" d="M-3.5 4 L0 -2 L3.5 4 V62 H-3.5 Z"></path>
  </g>

  <g transform={`translate(${ball.x} ${ball.y})`}>
    <ellipse class="oob__shadow" cx="2" cy="6" rx="8" ry="2.5"></ellipse>
    <circle class="oob__ball" r="7"></circle>
  </g>
</svg>

<style>
  .oob {
    width: 100%;
    height: auto;
  }

  .oob__line {
    fill: none;
    stroke: var(--color-accent);
    stroke-opacity: 0.22;
    stroke-width: 1;
  }

  .oob__line--major {
    stroke-opacity: 0.4;
    stroke-width: 1.4;
  }

  .oob__cup {
    fill: var(--color-accent-deep);
  }

  .oob__pole {
    stroke: var(--color-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .oob__flag {
    fill: var(--color-flag);
  }

  .oob__tufts path {
    fill: none;
    stroke: var(--color-accent);
    stroke-opacity: 0.55;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .oob__stake {
    fill: #fff;
    stroke: var(--color-ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .oob__ball {
    fill: #fff;
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .oob__shadow {
    fill: var(--color-ink);
    opacity: 0.18;
  }
</style>
