---
// Hero illustration: contour map of a green and a flag, with random shots
// flying in from the left one at a time, on a loop. About 1 in 10 is a hole in
// one, with a small celebration. The markup renders one finished shot, which is
// what reduced-motion and no-JS visitors see.
import { contourPaths } from "../../lib/topo";
import { flightPath, type Shot } from "../../lib/shots";

const SIZE = 600;
const pin = { x: 372, y: 250 };
const contours = contourPaths({
  cx: pin.x,
  cy: pin.y,
  rings: 14,
  spacing: 26,
  seed: 18,
});

const staticShot: Shot = {
  start: { x: 40, y: 560 },
  control: { x: 150, y: 20 },
  land: { x: pin.x - 30, y: pin.y + 10 },
  rest: { x: pin.x - 22, y: pin.y + 8 },
  ace: false,
};

// The pin flag: a rectangular pennant at the top of the pole, in art units.
const POLE_HEIGHT = 138;
const FLAG = { width: 66, height: 40, text: "WO’D" };

// Confetti pieces for the hole-in-one celebration, cycling through brand colors.
const CONFETTI_PIECES = 14;
const confettiColors = ["green", "sand", "flag", "white"];
---

<svg
  class="topo"
  viewBox={`0 0 ${SIZE} ${SIZE}`}
  role="img"
  aria-label={`Contour map of a golf green with a flag reading ${FLAG.text} and a ball flight landing near the pin`}
  data-topo
  data-pin-x={pin.x}
  data-pin-y={pin.y}
  data-size={SIZE}
  data-static-shot={JSON.stringify(staticShot)}
>
  <defs>
    <radialGradient id="topo-green" cx="50%" cy="50%" r="50%">
      <stop
        offset="0%"
        stop-color="var(--color-accent)"
        stop-opacity="0.22"
      ></stop>
      <stop
        offset="100%"
        stop-color="var(--color-accent)"
        stop-opacity="0"
      ></stop>
    </radialGradient>
    <!-- Soft light band that rolls across the flag, like folds in the cloth. -->
    <linearGradient id="topo-fold" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.28"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <clipPath id="topo-cloth-clip">
      <rect
        y={-POLE_HEIGHT}
        width={FLAG.width}
        height={FLAG.height}
        rx="2"
      ></rect>
    </clipPath>
  </defs>

  <ellipse
    cx={pin.x}
    cy={pin.y}
    rx="150"
    ry="120"
    fill="url(#topo-green)"
  ></ellipse>

  <g class="topo__lines">
    {contours.map((d, i) => (
      <path
        d={d}
        class:list={["topo__line", { "topo__line--major": i % 4 === 1 }]}
      />
    ))}
  </g>

  <g transform={`translate(${pin.x} ${pin.y})`} aria-hidden="true">
    <ellipse class="topo__ripple" rx="9" ry="4" data-ripple></ellipse>
    <ellipse class="topo__ripple" rx="9" ry="4" data-ripple></ellipse>
  </g>

  <g class="topo__pin" transform={`translate(${pin.x} ${pin.y})`}>
    <ellipse class="topo__cup" rx="9" ry="4"></ellipse>
    <line class="topo__pole" x1="0" y1="0" x2="0" y2={-POLE_HEIGHT}></line>
    <!-- Outer group: the hole-in-one wave (script). Inner group: the wind (CSS). -->
    <g data-flag>
      <g class="topo__cloth">
        <rect
          class="topo__flag"
          y={-POLE_HEIGHT}
          width={FLAG.width}
          height={FLAG.height}
          rx="2"
        ></rect>
        <text
          class="topo__flag-text"
          x={FLAG.width / 2}
          y={-POLE_HEIGHT + FLAG.height / 2}
          aria-hidden="true"
        >
          {FLAG.text}
        </text>
        <g clip-path="url(#topo-cloth-clip)">
          <rect
            class="topo__fold"
            x={-FLAG.width}
            y={-POLE_HEIGHT}
            width={FLAG.width}
            height={FLAG.height}
            fill="url(#topo-fold)"
          ></rect>
        </g>
      </g>
    </g>
  </g>

  <g data-shot>
    <path class="topo__flight" d={flightPath(staticShot, 1)} data-flight></path>
    <g
      class="topo__ball"
      transform={`translate(${staticShot.rest.x} ${staticShot.rest.y})`}
      data-ball
    >
      <ellipse
        class="topo__ball-shadow"
        cx="2"
        cy="6"
        rx="8"
        ry="2.5"
        data-ball-shadow
      ></ellipse>
      <circle r="7" data-ball-body></circle>
    </g>
  </g>

  <g transform={`translate(${pin.x} ${pin.y})`} aria-hidden="true">
    {Array.from({ length: CONFETTI_PIECES }, (_, i) => (
      <rect
        class={`topo__confetti topo__confetti--${confettiColors[i % confettiColors.length]}`}
        x="-3.5"
        y="-2"
        width="7"
        height="4"
        rx="0.5"
        data-confetti
      />
    ))}
  </g>
</svg>

<script>
  import {
    flightPath,
    nextShotIsAce,
    pointBetween,
    pointOnFlight,
    randomShot,
    type Shot,
    type ShotArea,
  } from "../../lib/shots";

  // Phase lengths in ms. A normal shot is about 4s; an ace swaps the hold for
  // the ball dropping in and a short celebration, about 5s.
  const NORMAL_PHASES = [
    ["flight", 1600],
    ["roll", 600],
    ["hold", 700],
    ["fade", 500],
    ["gap", 400],
  ] as const;
  const CELEBRATE_MS = 1300;
  const ACE_PHASES = [
    ["flight", 1600],
    ["roll", 900],
    ["drop", 250],
    ["celebrate", CELEBRATE_MS],
    ["fade", 500],
    ["gap", 400],
  ] as const;
  type Phases = typeof NORMAL_PHASES | typeof ACE_PHASES;
  type Phase = Phases[number][0];

  const RIPPLE_MAX_RX = 64;
  const RIPPLE_ASPECT = 4 / 9; // Matches the cup ellipse (rx 9, ry 4).
  const RIPPLE_STAGGER = 0.22; // Second ring starts this far into the celebration.
  const CONFETTI_GRAVITY = 260; // viewBox units per second squared.

  const easeOutQuad = (t: number) => 1 - (1 - t) * (1 - t);
  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
  const clamp01 = (t: number) => Math.min(1, Math.max(0, t));

  type ConfettiPiece = { vx: number; vy: number; spin: number };

  function startShotLoop(svg: SVGSVGElement) {
    const required = <T extends SVGElement>(selector: string): T => {
      const el = svg.querySelector<T>(selector);
      if (!el)
        throw new Error(`[TopoGreen] Shot loop markup is missing ${selector}`);
      return el;
    };
    const group = required<SVGGElement>("[data-shot]");
    const flight = required<SVGPathElement>("[data-flight]");
    const ball = required<SVGGElement>("[data-ball]");
    const body = required<SVGCircleElement>("[data-ball-body]");
    const shadow = required<SVGEllipseElement>("[data-ball-shadow]");
    const flag = required<SVGGElement>("[data-flag]");
    const ripples = [
      ...svg.querySelectorAll<SVGEllipseElement>("[data-ripple]"),
    ];
    const confetti = [
      ...svg.querySelectorAll<SVGRectElement>("[data-confetti]"),
    ];
    if (ripples.length === 0 || confetti.length === 0) {
      throw new Error(
        "[TopoGreen] Shot loop markup is missing the celebration",
      );
    }

    const attr = (name: string) =>
      `data-${name.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}`;
    const data = (name: string): string => {
      const value = svg.dataset[name];
      if (value === undefined || value === "") {
        throw new Error(`[TopoGreen] Missing attribute ${attr(name)}`);
      }
      return value;
    };
    const number = (name: string): number => {
      const value = Number(data(name));
      if (!Number.isFinite(value)) {
        throw new Error(`[TopoGreen] Attribute ${attr(name)} is not a number`);
      }
      return value;
    };

    const area: ShotArea = {
      pin: { x: number("pinX"), y: number("pinY") },
      size: number("size"),
    };

    // Start on the finished static shot so the handoff from the no-JS markup
    // is a fade, not a jump. Random shots take over from the next loop.
    const staticShot: Shot = JSON.parse(data("staticShot"));
    let shot = staticShot;
    let phases: Phases = NORMAL_PHASES;
    let phaseIndex = phases.findIndex(([phase]) => phase === "hold");
    let phaseElapsed = 0;
    let lastTime: number | null = null;
    let frame = 0;
    let onScreen = false;
    let pieces: ConfettiPiece[] = [];

    function newShot() {
      const ace = nextShotIsAce(shot.ace);
      shot = randomShot(area, { ace });
      phases = ace ? ACE_PHASES : NORMAL_PHASES;
      if (ace) {
        // Upward burst, fanned out, each piece with its own spin.
        pieces = confetti.map(() => {
          const angle = -Math.PI / 2 + (Math.random() - 0.5) * 1.8;
          const speed = 120 + Math.random() * 110;
          return {
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            spin: (Math.random() - 0.5) * 900,
          };
        });
      }
    }

    const placeBall = (x: number, y: number, scale: number) => {
      ball.setAttribute(
        "transform",
        `translate(${x.toFixed(1)} ${y.toFixed(1)})`,
      );
      body.setAttribute("transform", `scale(${scale.toFixed(3)})`);
    };

    function hideCelebration() {
      ripples.forEach((ring) => (ring.style.opacity = "0"));
      confetti.forEach((piece) => (piece.style.opacity = "0"));
      flag.removeAttribute("transform");
    }

    function renderCelebration(p: number) {
      const seconds = (p * CELEBRATE_MS) / 1000;

      ripples.forEach((ring, i) => {
        const t = clamp01((p - i * RIPPLE_STAGGER) / (1 - RIPPLE_STAGGER));
        const rx = 9 + (RIPPLE_MAX_RX - 9) * easeOutCubic(t);
        ring.setAttribute("rx", rx.toFixed(1));
        ring.setAttribute("ry", (rx * RIPPLE_ASPECT).toFixed(1));
        ring.style.opacity = t > 0 && t < 1 ? String(0.6 * (1 - t)) : "0";
      });

      // One quick wave in the first half, pivoting on the pole.
      const wave = p < 0.5 ? Math.sin(p * 4 * Math.PI) * (1 - p * 2) : 0;
      flag.setAttribute(
        "transform",
        `scale(${(1 - 0.22 * wave).toFixed(3)} 1)`,
      );

      confetti.forEach((el, i) => {
        const { vx, vy, spin } = pieces[i];
        const x = vx * seconds;
        const y = vy * seconds + 0.5 * CONFETTI_GRAVITY * seconds * seconds;
        el.setAttribute(
          "transform",
          `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${(spin * seconds).toFixed(0)})`,
        );
        el.style.opacity = String(p < 0.6 ? 1 : 1 - (p - 0.6) / 0.4);
      });
    }

    function render(phase: Phase, p: number) {
      if (phase === "flight") {
        const t = easeOutQuad(p);
        const at = pointOnFlight(shot, t);
        flight.setAttribute("d", flightPath(shot, t));
        // Slightly bigger at the top of the arc, as if nearer the viewer.
        placeBall(at.x, at.y, 1 + 0.35 * Math.sin(Math.PI * t));
        shadow.style.opacity = "0";
        ball.style.opacity = "1";
        group.style.opacity = "1";
        hideCelebration();
      } else if (phase === "roll") {
        // Aces keep some pace so the ball visibly runs into the cup.
        const ease = shot.ace ? easeOutQuad : easeOutCubic;
        const at = pointBetween(shot.land, shot.rest, ease(p));
        placeBall(at.x, at.y, 1);
        shadow.style.opacity = "";
      } else if (phase === "drop") {
        placeBall(shot.rest.x, shot.rest.y, 1 - 0.6 * p);
        shadow.style.opacity = "0";
        ball.style.opacity = String(1 - p);
      } else if (phase === "celebrate") {
        renderCelebration(p);
      } else if (phase === "fade") {
        hideCelebration();
        group.style.opacity = String(1 - p);
      } else if (phase === "gap") {
        group.style.opacity = "0";
      }
    }

    function tick(now: number) {
      const dt = lastTime === null ? 0 : now - lastTime;
      lastTime = now;
      phaseElapsed += dt;

      // Advance through any phases that finished since the last frame.
      while (phaseElapsed >= phases[phaseIndex][1]) {
        render(phases[phaseIndex][0], 1);
        phaseElapsed -= phases[phaseIndex][1];
        phaseIndex += 1;
        if (phaseIndex === phases.length) {
          phaseIndex = 0;
          newShot();
        }
      }

      const [phase, duration] = phases[phaseIndex];
      render(phase, phaseElapsed / duration);
      frame = requestAnimationFrame(tick);
    }

    // Back to the finished static shot, as reduced-motion visitors see it.
    function showStatic() {
      shot = staticShot;
      phases = NORMAL_PHASES;
      phaseIndex = phases.findIndex(([phase]) => phase === "hold");
      phaseElapsed = 0;
      flight.setAttribute("d", flightPath(staticShot, 1));
      placeBall(staticShot.rest.x, staticShot.rest.y, 1);
      shadow.style.opacity = "";
      ball.style.opacity = "1";
      group.style.opacity = "1";
      hideCelebration();
    }

    // Only runs while motion is allowed, the hero is on screen and the tab is visible.
    function sync() {
      const active =
        !reducedMotion.matches &&
        onScreen &&
        document.visibilityState === "visible";
      // The flag's wind is a CSS animation; pause it along with the shots.
      svg.classList.toggle("is-paused", !active);
      if (active && !frame) {
        lastTime = null;
        frame = requestAnimationFrame(tick);
      } else if (!active && frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    }

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(svg);
    document.addEventListener("visibilitychange", sync);
    reducedMotion.addEventListener("change", () => {
      if (reducedMotion.matches) showStatic();
      sync();
    });
  }

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  document
    .querySelectorAll<SVGSVGElement>("[data-topo]")
    .forEach(startShotLoop);
</script>

<style>
  .topo {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .topo__line {
    fill: none;
    stroke: var(--color-accent);
    stroke-opacity: 0.22;
    stroke-width: 1;
  }

  .topo__line--major {
    stroke-opacity: 0.4;
    stroke-width: 1.4;
  }

  .topo__flight {
    fill: none;
    stroke: var(--color-accent-strong);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
  }

  .topo__cup {
    fill: var(--color-accent-deep);
  }

  .topo__pole {
    stroke: var(--color-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .topo__flag {
    fill: var(--color-flag);
  }

  .topo__flag-text {
    fill: #fff;
    font-family: var(--font-display), system-ui, sans-serif;
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* Wind: the cloth sways from the pole, and a light band rolls across it. */
  .topo__cloth {
    transform-box: fill-box;
    transform-origin: left center;
    animation: topo-wind 2.6s ease-in-out infinite;
  }

  .topo__fold {
    animation: topo-fold 2.6s linear infinite;
  }

  .topo.is-paused .topo__cloth,
  .topo.is-paused .topo__fold {
    animation-play-state: paused;
  }

  @keyframes topo-wind {
    0%,
    100% {
      transform: skewY(0deg) scaleX(1);
    }
    25% {
      transform: skewY(-3deg) scaleX(0.96);
    }
    50% {
      transform: skewY(1deg) scaleX(0.99);
    }
    75% {
      transform: skewY(3deg) scaleX(0.95);
    }
  }

  @keyframes topo-fold {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(132px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topo__cloth,
    .topo__fold {
      animation: none;
    }
  }

  .topo__ball circle {
    fill: #fff;
    stroke: var(--color-ink);
    stroke-width: 1.5;
  }

  .topo__ball-shadow {
    fill: var(--color-ink);
    opacity: 0.18;
  }

  /* Hole-in-one celebration. Hidden until the script animates it. */
  .topo__ripple {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    opacity: 0;
  }

  .topo__confetti {
    opacity: 0;
  }

  .topo__confetti--green {
    fill: var(--color-accent);
  }

  .topo__confetti--sand {
    fill: var(--color-sand);
  }

  .topo__confetti--flag {
    fill: var(--color-flag);
  }

  .topo__confetti--white {
    fill: #fff;
    stroke: var(--color-line);
    stroke-width: 0.5;
  }
</style>
