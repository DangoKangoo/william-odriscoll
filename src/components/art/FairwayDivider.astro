---
// Gentle fairway curve between two sections. `fill` is the color of the section
// below; `mirror` flips the curve left to right.
interface Props {
  fill: string;
  background: string;
  mirror?: boolean;
}

const { fill, background, mirror = false } = Astro.props;
---

<div
  class="divider"
  style={`--divider-fill: ${fill}; --divider-bg: ${background}`}
  aria-hidden="true"
>
  <svg
    viewBox="0 0 1440 90"
    preserveAspectRatio="none"
    class:list={{ "divider--mirror": mirror }}
  >
    <path
      d="M0 58C240 18 480 8 720 30s520 52 720 14V90H0Z"
      opacity="0.5"
    ></path>
    <path d="M0 70C300 30 560 26 820 50s440 34 620 4V90H0Z"></path>
  </svg>
</div>

<style>
  .divider {
    background: var(--divider-bg);
    line-height: 0;
  }

  svg {
    width: 100%;
    height: clamp(40px, 6vw, 90px);
    fill: var(--divider-fill);
  }

  .divider--mirror {
    transform: scaleX(-1);
  }
</style>
