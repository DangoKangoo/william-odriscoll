---
import Logo from "../art/Logo.astro";
import { site } from "../../config/site";
import { withBase } from "../../lib/url";
---

<header class="header">
  <div class="container header__inner">
    <a class="brand" href={withBase("/")} aria-label={`${site.name}, home`}>
      <span class="brand__mark">
        <Logo />
      </span>
      {site.name}
    </a>
    <nav aria-label="Main">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={withBase(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgb(227 226 218 / 70%);
    background: rgb(247 246 241 / 82%);
    backdrop-filter: saturate(1.4) blur(12px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display), system-ui, sans-serif;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand__mark {
    display: inline-flex;
    color: var(--color-accent);
  }

  ul {
    display: flex;
    gap: clamp(var(--space-3), 3vw, var(--space-6));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--color-muted);
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  nav a:hover {
    color: var(--color-ink);
  }

  @media (max-width: 26rem) {
    nav li:not(:last-child) {
      display: none;
    }
  }
</style>
