---
// Browser-window chrome around a site preview. The slot is the viewport.
// Pass `url` for a real site (its host shows in the address bar), or
// `address` for a label. `badge` is the corner tag (e.g. "Screenshot").
interface Props {
  url?: string;
  address?: string;
  badge?: string;
}

const { url, address, badge } = Astro.props;
if (!url && !address) {
  throw new Error("[BrowserFrame] Pass either url or address.");
}
const label = address ?? new URL(url!).host.replace(/^www\./, "");
---

<div class="frame">
  <div class="frame__bar" aria-hidden="true">
    <span class="frame__dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="frame__address">{label}</span>
  </div>
  <div class="frame__viewport">
    <slot />
    {badge && (
      <span class="frame__badge" data-badge>
        {badge}
      </span>
    )}
  </div>
</div>

<style>
  .frame {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .frame__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--color-line);
    background: #fbfbf8;
  }

  .frame__dots {
    display: flex;
    gap: 6px;
  }

  .frame__dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-line);
  }

  .frame__address {
    padding: 0.15rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .frame__viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg);
  }

  .frame__badge {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgb(16 35 26 / 78%);
    color: var(--color-on-accent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    backdrop-filter: blur(6px);
  }
</style>
