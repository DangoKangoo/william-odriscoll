---
// A real project that hasn't launched yet: a wireframe "under construction"
// inside the browser frame. Anonymous on purpose, and no link.
import BrowserFrame from "./BrowserFrame.astro";

interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<article class="card">
  <BrowserFrame address="in progress" badge="In progress">
    <div class="wire" aria-hidden="true">
      <div class="wire__bar">
        <i class="wire__logo"></i>
        <i class="wire__nav"></i>
        <i class="wire__nav"></i>
        <i class="wire__nav"></i>
      </div>
      <div class="wire__hero">
        <i class="wire__title"></i>
        <i class="wire__text"></i>
        <i class="wire__button"></i>
      </div>
      <div class="wire__row">
        <i></i>
        <i></i>
        <i></i>
      </div>
    </div>
  </BrowserFrame>

  <div class="card__body">
    <div class="card__meta">
      <span class="card__dot" aria-hidden="true"></span>
      <span>Building now</span>
    </div>
    <h3>{title}</h3>
    <p>{body}</p>
  </div>
</article>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: var(--space-5);
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .wire {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 8%;
    padding: 5% 7%;
    background: var(--color-surface);
  }

  .wire i {
    display: block;
    border-radius: 4px;
    background: var(--color-line);
  }

  .wire__hero,
  .wire__row i {
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-sm);
  }

  .wire__row i {
    background: var(--color-bg);
  }

  .wire__bar {
    display: flex;
    align-items: center;
    gap: 4%;
  }

  .wire__logo {
    width: 14%;
    height: 10px;
    margin-right: auto;
  }

  .wire__nav {
    width: 9%;
    height: 6px;
  }

  .wire__hero {
    padding: 4%;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
  }

  .wire__title {
    width: 52%;
    height: 14px;
  }

  .wire__text {
    width: 36%;
    height: 7px;
  }

  .wire__button {
    width: 16%;
    height: 12px;
    margin-top: 4px;
    background: var(--color-accent-soft) !important;
  }

  .wire__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5%;
  }

  .wire__row i {
    height: 34px;
  }

  /* A slow shimmer across the wireframe, like it's still being drawn. */
  .wire::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgb(255 255 255 / 70%) 50%,
      transparent 70%
    );
    background-size: 250% 100%;
    animation: wire-shimmer 2.8s ease-in-out infinite;
  }

  @keyframes wire-shimmer {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -120% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wire::after {
      display: none;
    }
  }

  .card__body {
    display: grid;
    gap: var(--space-3);
    padding: 0 var(--space-3) var(--space-3);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  h3 {
    font-size: var(--font-size-lg);
  }

  p {
    color: var(--color-muted);
    font-size: var(--font-size-sm);
  }
</style>
