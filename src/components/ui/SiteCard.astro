---
// One client site as a feature row: the preview on one side, the details on
// the other. Odd rows flip sides on desktop. The preview is a live iframe when
// the site allows framing from this origin, otherwise its screenshot.
import { Image } from "astro:assets";
import BrowserFrame from "./BrowserFrame.astro";
import type { Site } from "../../lib/sites";

interface Props {
  site: Site;
  index: number;
}

const { site, index } = Astro.props;
const year = site.launched.slice(0, 4);
---

<article class:list={["project", { "project--flip": index % 2 === 1 }]}>
  <div class="project__preview">
    <BrowserFrame url={site.url}>
      <Image
        class="project__shot"
        src={site.screenshot}
        alt={`Screenshot of the ${site.name} website`}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 60rem) 42rem, 92vw"
        loading={index === 0 ? "eager" : "lazy"}
      />
      {site.embed.embeddable && (
        <div
          class="project__live"
          data-live-preview
          data-timeout-ms="8000"
          inert
        >
          <iframe
            src={site.url}
            title={`Live preview of ${site.name}`}
            loading="lazy"
            sandbox="allow-scripts allow-same-origin"
            referrerpolicy="no-referrer"
            scrolling="no"
            tabindex="-1"
            aria-hidden="true"
          ></iframe>
        </div>
      )}
    </BrowserFrame>
  </div>

  <div class="project__body">
    <div class="project__meta">
      <span>{site.location}</span>
      <span aria-hidden="true">·</span>
      <span>Launched {year}</span>
    </div>
    <h3>
      <a class="project__link" href={site.url} target="_blank" rel="noopener">
        {site.name}
        <svg class="project__arrow" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M5 11 11 5M6 5h5v5"></path>
        </svg>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </h3>
    <p>{site.description}</p>
    <ul class="project__tags" aria-label="Highlights">
      {site.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>
</article>

<script>
  // Scales each 1280x800 iframe to fit its frame and fades it in once it
  // loads. If it never loads, the screenshot underneath stays.
  const DESKTOP_WIDTH = 1280;

  for (const live of document.querySelectorAll<HTMLElement>(
    "[data-live-preview]",
  )) {
    const iframe = live.querySelector("iframe");
    if (!iframe) continue;

    new ResizeObserver(([entry]) => {
      live.style.setProperty(
        "--scale",
        String(entry.contentRect.width / DESKTOP_WIDTH),
      );
    }).observe(live);

    // The iframe is lazy, so start the timeout only once the card is near the
    // viewport. Starting it at page load could remove a preview before it loads.
    let timeout = 0;
    const nearView = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        nearView.disconnect();
        timeout = window.setTimeout(() => {
          live.remove();
          console.warn(
            `[SiteCard] Live preview timed out, showing screenshot: ${iframe.src}`,
          );
        }, Number(live.dataset.timeoutMs));
      },
      { rootMargin: "200px" },
    );
    nearView.observe(live);

    iframe.addEventListener("load", () => {
      nearView.disconnect();
      window.clearTimeout(timeout);
      live.classList.add("is-loaded");
    });
  }
</script>

<style>
  .project {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--space-5);
  }

  @media (min-width: 60rem) {
    .project {
      grid-template-columns: 1.6fr 1fr;
      gap: var(--space-8);
    }

    .project--flip {
      grid-template-columns: 1fr 1.6fr;
    }

    .project--flip .project__preview {
      order: 2;
    }
  }

  .project__preview {
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
  }

  .project__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .project__live {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }

  .project__live.is-loaded {
    opacity: 1;
  }

  .project__live iframe {
    width: 1280px;
    height: 800px;
    border: 0;
    transform: scale(var(--scale, 0.4));
    transform-origin: top left;
    pointer-events: none;
  }

  .project__body {
    display: grid;
    gap: var(--space-3);
  }

  .project__meta {
    display: flex;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
  }

  h3 {
    font-size: var(--font-size-xl);
  }

  .project__link {
    text-decoration: none;
  }

  /* The whole row is clickable through the title link. z-index keeps it above
     the preview, which paints later in flipped rows. */
  .project__link::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .project__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .project__link:focus-visible {
    outline: none;
  }

  .project__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
  }

  /* Inline, so it follows the last word when the name wraps. */
  .project__arrow {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-left: 0.15em;
    vertical-align: 0.15em;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project__body p {
    color: var(--color-muted);
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .project__tags li {
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
