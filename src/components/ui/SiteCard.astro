---
// One client site: a live iframe preview when the site allows framing from this
// origin, otherwise its screenshot. The badge always says which one is showing.
import { Image } from "astro:assets";
import BrowserFrame from "./BrowserFrame.astro";
import type { Site } from "../../lib/sites";

interface Props {
  site: Site;
  index: number;
}

const { site, index } = Astro.props;
const year = site.launched.slice(0, 4);
---

<article class="card">
  <BrowserFrame url={site.url} badge="Screenshot">
    <Image
      class="card__shot"
      src={site.screenshot}
      alt={`Screenshot of the ${site.name} website`}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 60rem) 34rem, 92vw"
      loading={index === 0 ? "eager" : "lazy"}
    />
    {site.embed.embeddable && (
      <div class="card__live" data-live-preview data-timeout-ms="8000" inert>
        <iframe
          src={site.url}
          title={`Live preview of ${site.name}`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin"
          referrerpolicy="no-referrer"
          tabindex="-1"
          aria-hidden="true"
        ></iframe>
      </div>
    )}
  </BrowserFrame>

  <div class="card__body">
    <div class="card__meta">
      <span>{site.location}</span>
      <span aria-hidden="true">·</span>
      <span>Launched {year}</span>
    </div>
    <h3>
      <a class="card__link" href={site.url} target="_blank" rel="noopener">
        {site.name}
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      <svg class="card__arrow" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M5 11 11 5M6 5h5v5"></path>
      </svg>
    </h3>
    <p>{site.description}</p>
    <ul class="card__tags" aria-label="Highlights">
      {site.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>
</article>

<script>
  // Scales each 1280x800 iframe to fit its card, and swaps the badge to
  // "Live preview" once it loads. If it never loads, the screenshot stays.
  const DESKTOP_WIDTH = 1280;

  for (const live of document.querySelectorAll<HTMLElement>(
    "[data-live-preview]",
  )) {
    const iframe = live.querySelector("iframe");
    const badge =
      live.parentElement?.querySelector<HTMLElement>("[data-badge]");
    if (!iframe || !badge) continue;

    new ResizeObserver(([entry]) => {
      live.style.setProperty(
        "--scale",
        String(entry.contentRect.width / DESKTOP_WIDTH),
      );
    }).observe(live);

    // The iframe is lazy, so start the timeout only once the card is near the
    // viewport. Starting it at page load could remove a preview before it loads.
    let timeout = 0;
    const nearView = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        nearView.disconnect();
        timeout = window.setTimeout(() => {
          live.remove();
          console.warn(
            `[SiteCard] Live preview timed out, showing screenshot: ${iframe.src}`,
          );
        }, Number(live.dataset.timeoutMs));
      },
      { rootMargin: "200px" },
    );
    nearView.observe(live);

    iframe.addEventListener("load", () => {
      nearView.disconnect();
      window.clearTimeout(timeout);
      live.classList.add("is-loaded");
      badge.textContent = "Live preview";
    });
  }
</script>

<style>
  .card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding: var(--space-3);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      translate var(--duration-base) var(--ease-out);
  }

  .card:hover {
    box-shadow: var(--shadow-lift);
    translate: 0 -4px;
  }

  .card__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .card__live {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--duration-base) ease;
  }

  .card__live.is-loaded {
    opacity: 1;
  }

  .card__live iframe {
    width: 1280px;
    height: 800px;
    border: 0;
    transform: scale(var(--scale, 0.4));
    transform-origin: top left;
    pointer-events: none;
  }

  .card__body {
    display: grid;
    gap: var(--space-3);
    padding: 0 var(--space-3) var(--space-3);
  }

  .card__meta {
    display: flex;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
  }

  h3 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-lg);
  }

  .card__link {
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .card__arrow {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate var(--duration-fast) ease;
  }

  .card:hover .card__arrow {
    translate: 2px -2px;
  }

  .card__body p {
    color: var(--color-muted);
    font-size: var(--font-size-sm);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding: 0;
    list-style: none;
  }

  .card__tags li {
    padding: 0.2rem 0.7rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
