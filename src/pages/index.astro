---
import Base from "../layouts/Base.astro";
import FairwayDivider from "../components/art/FairwayDivider.astro";
import Hero from "../components/sections/Hero.astro";
import Work from "../components/sections/Work.astro";
import Services from "../components/sections/Services.astro";
import Contact from "../components/sections/Contact.astro";
import { site } from "../config/site";
---

<Base title={`${site.name} | ${site.role}`} description={site.description}>
  <Hero />
  <FairwayDivider fill="var(--color-surface)" background="var(--color-bg)" />
  <Work />
  <Services />
  <Contact />
</Base>
